# ========================================================
# Configuração do Banco de Dados - OdontoGestão
# ========================================================

PORT=3001

# --- OPÇÃO 1: Banco Local SQLite (Ativo por padrão, funciona sem internet) ---
DATABASE_URL="file:./dev.db"

# --- OPÇÃO 2: Banco em Nuvem Supabase (PostgreSQL) ---
# Para ativar o Supabase:
# 1. Altere o provider no arquivo prisma/schema.prisma para: provider = "postgresql" e adicione directUrl = env("DIRECT_URL")
# 2. Descomente as duas linhas abaixo e substitua [SUA-REFERENCIA-DO-PROJETO] pelo ID do seu projeto no Supabase:
# DATABASE_URL="postgresql://postgres.[SUA-REFERENCIA-DO-PROJETO]:9n1XOG8fSq9LvLDm@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[SUA-REFERENCIA-DO-PROJETO]:9n1XOG8fSq9LvLDm@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

